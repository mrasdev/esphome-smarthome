# Copy this file to secrets.yaml and fill in your own values.
# secrets.yaml is gitignored and must never be committed.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

api_encryption_key_garage_door: "generate-with: esphome generate-api-key"
ota_password_garage_door: "generate-a-random-hex-string"
ap_password_garage_door: "fallback-hotspot-password"

